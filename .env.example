# Netlify DB (Neon) connection string. Get from Netlify dashboard → Project → Add-ons → Netlify DB.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Random long string used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Bootstrap admin (used by `npm run db:seed-admin`). Change in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
